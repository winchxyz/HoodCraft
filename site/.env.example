# ---------------------------------------------------------------------------
# HoodCraft mascot vote
#
# Copy to .env.local and fill in. The site runs with NONE of this set: it
# starts in "equal" mode, where every verified wallet counts once. Switch to
# token weighting when you have the contract.
# ---------------------------------------------------------------------------

# "equal" - one verified wallet, one vote. No chain needed. (default)
# "token" - weight is the wallet's balance at a pinned block. Needs all four
#           values below.
VOTE_MODE=equal

# --- Required when VOTE_MODE=token ----------------------------------------

# Chain id of the network the token lives on, e.g. 1 for Ethereum mainnet.
# CHAIN_ID=

# Your own RPC endpoint. NEVER prefix this NEXT_PUBLIC_ - it must stay on the
# server. If the snapshot block is older than the node's pruning window, this
# has to be an archive-capable endpoint or the historical read is rejected.
# RPC_URL=

# The ERC-20 contract address whose balances decide vote weight.
# TOKEN_ADDRESS=

# The block every balance is read at. Pick one and leave it alone: this single
# number is what stops the same tokens voting twice by moving between wallets.
# "latest" is rejected on purpose.
# TOKEN_SNAPSHOT_BLOCK=

# --- Optional --------------------------------------------------------------

# Cosmetic, shown in the UI.
# CHAIN_NAME=Robinhood Chain
# CHAIN_CURRENCY_SYMBOL=ETH
# EXPLORER_URL=https://explorer.example.com

# Pin the origin that sign-in messages are bound to. Set this in production;
# in development it is taken from the request.
# APP_ORIGIN=https://vote.hoodcraft.example

# Where the SQLite vote store lives.
# DATABASE_PATH=./data/votes.db
