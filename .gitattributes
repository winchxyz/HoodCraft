# Normalise to LF in the repository; check out native on Windows.
* text=auto

# gradlew is executed by the Linux CI runner, so it must stay LF even on a Windows checkout.
gradlew        text eol=lf
*.sh           text eol=lf
*.bat          text eol=crlf
*.ps1          text eol=crlf

# Binaries git must not touch.
*.png          binary
*.webp         binary
*.ogg          binary
*.jar          binary
*.nbt          binary
